# Trainlio — Sports Training Booking Platform
# Copy to .env.local. Every value is validated at startup by src/lib/env.ts.

# Supabase project. The anon key is safe in the browser: it carries no
# authority of its own, and row level security decides what each user may read.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served. Auth redirects come back here, and
# supabase/config.toml reads it for site_url.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Bypasses row level security entirely. Used only by the notification drain job
# and administrative tooling. Never prefix this NEXT_PUBLIC_, and never import
# the admin client outside src/server/** — a lint rule enforces both.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for transactional email and for Supabase Auth OTP via custom SMTP.
# Supabase's default SMTP is rate limited and is not a production option.
RESEND_API_KEY=

# Sender for OTP and transactional email. Must be an address on a domain you
# have verified in Resend, otherwise nothing is delivered.
AUTH_SENDER_EMAIL=trainlio@your-verified-domain.cz

# Shared secret for the notification drain cron route (vercel.json, every five
# minutes). At least 16 characters. Vercel sends it as `Authorization: Bearer
# $CRON_SECRET`; set it in the Vercel project's environment variables, not only
# here, or the schedule fires and is refused. Generate with
# `openssl rand -base64 32`.
CRON_SECRET=
