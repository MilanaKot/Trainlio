# Trainlio — Sports Training Booking Platform
# Copy to .env.local. Every value is validated at startup by src/lib/env.ts.

# Supabase project. The anon key is safe in the browser: it carries no
# authority of its own, and row level security decides what each user may read.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security entirely. Used only by the notification drain job
# and administrative tooling. Never prefix this NEXT_PUBLIC_, and never import
# the admin client outside src/server/** — a lint rule enforces both.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for transactional email and for Supabase Auth OTP via custom SMTP.
# Supabase's default SMTP is rate limited and is not a production option.
RESEND_API_KEY=

# Shared secret for the notification drain cron route. At least 16 characters.
CRON_SECRET=
